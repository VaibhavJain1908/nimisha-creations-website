      "mode": "managed",
      "type": "aws_cloudfront_function",
      "name": "url_rewrite",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "arn": "arn:aws:cloudfront::255325274897:function/nimisha-creations-url-rewrite",
            "code": "async function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  // If no extension and not root, append .html\n  if (!uri.includes('.') \u0026\u0026 uri !== '/') {\n    if (uri.endsWith('/')) {\n      request.uri = uri + 'index.html';\n    } else {\n      request.uri = uri + '.html';\n    }\n  }\n  return request;\n}\n",
            "comment": "Rewrite clean URLs to .html files",
            "etag": "ETVPDKIKX0DER",
            "id": "nimisha-creations-url-rewrite",
            "key_value_store_associations": [],
            "live_stage_etag": "ETVPDKIKX0DER",
